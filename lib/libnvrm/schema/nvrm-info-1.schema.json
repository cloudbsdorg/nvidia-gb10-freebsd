{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cloudbsd:nvrm:schema:nvrm-info/1",
  "title": "nvrm-info output, major version 1, minor 2",
  "description": "One schema for every nvrm-info mode: --json prints one document; --jsonl prints a header, one device per line and an end record; a failure prints an error. Generated by nvrm-info --schema from the library's field table; do not edit.",
  "oneOf": [
    { "$ref": "#/$defs/document" },
    { "$ref": "#/$defs/header" },
    { "$ref": "#/$defs/device_record" },
    { "$ref": "#/$defs/end" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "source": { "enum": ["rm", "os", "derived", "family", "board"] },
    "reason_id": { "enum": ["not_queried", "rm_control_failed", "rm_not_supported", "os_not_reported", "family_unknown", "input_unavailable", "no_numa_node", "backend_does_not_provide", "class_absent", "os_call_failed", "value_unusable", "family_has_no_class", "version_unparsed", "version_inconsistent"] },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "reason_id", "reason", "source"],
      "properties": {
        "available": { "const": false },
        "reason_id": { "$ref": "#/$defs/reason_id" },
        "reason": { "type": "string" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "version_part": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "version": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "string", "major", "minor", "patch", "parts", "source"],
          "properties": {
            "available": { "const": true },
            "string": { "type": "string" },
            "major": { "$ref": "#/$defs/version_part" },
            "minor": { "$ref": "#/$defs/version_part" },
            "patch": { "$ref": "#/$defs/version_part" },
            "parts": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/version_part" } },
            "suffix": { "type": "string" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "string", "reason_id", "reason", "source"],
          "properties": {
            "available": { "const": false },
            "string": { "type": "string" },
            "reason_id": { "$ref": "#/$defs/reason_id" },
            "reason": { "type": "string" },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "rm_api", "built_for", "library", "library_symbols", "schema"],
      "properties": {
        "driver": { "$ref": "#/$defs/version" },
        "rm_api": { "$ref": "#/$defs/version" },
        "built_for": { "$ref": "#/$defs/version" },
        "library": { "$ref": "#/$defs/version" },
        "library_symbols": { "$ref": "#/$defs/version" },
        "schema": { "$ref": "#/$defs/version" }
      }
    },
    "u64": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "value", "source"],
          "properties": {
            "available": { "const": true },
            "value": { "type": "integer", "minimum": 0 },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        { "$ref": "#/$defs/unavailable" }
      ]
    },
    "text": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "value", "source"],
          "properties": {
            "available": { "const": true },
            "value": { "type": "string" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        { "$ref": "#/$defs/unavailable" }
      ]
    },
    "list": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "value", "source"],
          "properties": {
            "available": { "const": true },
            "value": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        { "$ref": "#/$defs/unavailable" }
      ]
    },
    "capability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "name", "available", "value", "source"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 },
            "name": { "type": "string" },
            "available": { "const": true },
            "value": { "type": "boolean" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "name", "available", "reason_id", "reason", "source"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 },
            "name": { "type": "string" },
            "available": { "const": false },
            "reason_id": { "$ref": "#/$defs/reason_id" },
            "reason": { "type": "string" },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      ]
    },
    "group_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pci_domain", "pci_bus", "pci_slot", "pci_function", "pci_vendor", "pci_device", "pci_subsystem_vendor", "pci_subsystem_device", "pci_revision", "rm_gpu_id", "uuid"],
      "properties": {
        "pci_domain": { "$ref": "#/$defs/u64", "description": "PCI domain" },
        "pci_bus": { "$ref": "#/$defs/u64", "description": "PCI bus" },
        "pci_slot": { "$ref": "#/$defs/u64", "description": "PCI slot" },
        "pci_function": { "$ref": "#/$defs/u64", "description": "PCI function" },
        "pci_vendor": { "$ref": "#/$defs/u64", "description": "PCI vendor id" },
        "pci_device": { "$ref": "#/$defs/u64", "description": "PCI device id" },
        "pci_subsystem_vendor": { "$ref": "#/$defs/u64", "description": "PCI subsystem vendor id" },
        "pci_subsystem_device": { "$ref": "#/$defs/u64", "description": "PCI subsystem device id" },
        "pci_revision": { "$ref": "#/$defs/u64", "description": "PCI revision id" },
        "rm_gpu_id": { "$ref": "#/$defs/u64", "description": "opaque RM id of the GPU" },
        "uuid": { "$ref": "#/$defs/text", "description": "GPU UUID" }
      }
    },
    "group_gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "implementation", "chip_id", "sm_version_major", "sm_version_minor", "rm_sm_version", "compute_capability_major", "compute_capability_minor", "gpc_count", "tpc_count", "sm_count", "cls_gpfifo", "cls_compute", "cls_eng3d", "cls_copy", "classes", "family"],
      "properties": {
        "architecture": { "$ref": "#/$defs/u64", "description": "RM architecture id" },
        "implementation": { "$ref": "#/$defs/u64", "description": "RM implementation id" },
        "chip_id": { "$ref": "#/$defs/u64", "description": "architecture plus implementation" },
        "sm_version_major": { "$ref": "#/$defs/u64", "description": "RM SM version, major" },
        "sm_version_minor": { "$ref": "#/$defs/u64", "description": "RM SM version, minor" },
        "rm_sm_version": { "$ref": "#/$defs/u64", "description": "raw RM SM version code" },
        "compute_capability_major": { "$ref": "#/$defs/u64", "description": "CUDA compute capability, major" },
        "compute_capability_minor": { "$ref": "#/$defs/u64", "description": "CUDA compute capability, minor" },
        "gpc_count": { "$ref": "#/$defs/u64", "description": "enabled GPCs" },
        "tpc_count": { "$ref": "#/$defs/u64", "description": "enabled TPCs" },
        "sm_count": { "$ref": "#/$defs/u64", "description": "enabled SMs" },
        "cls_gpfifo": { "$ref": "#/$defs/u64", "description": "GPFIFO channel class" },
        "cls_compute": { "$ref": "#/$defs/u64", "description": "compute class" },
        "cls_eng3d": { "$ref": "#/$defs/u64", "description": "3D class" },
        "cls_copy": { "$ref": "#/$defs/u64", "description": "copy engine class" },
        "classes": { "$ref": "#/$defs/list", "description": "every class the GPU supports" },
        "family": { "$ref": "#/$defs/text", "description": "generation table row" }
      }
    },
    "group_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vram_size", "bar1_size", "max_page_size", "numa_node", "page_sizes"],
      "properties": {
        "vram_size": { "$ref": "#/$defs/u64", "description": "local video memory in bytes (0 on unified-memory parts)" },
        "bar1_size": { "$ref": "#/$defs/u64", "description": "BAR1 virtual range in bytes" },
        "max_page_size": { "$ref": "#/$defs/u64", "description": "largest page size the GPU MMU supports here, in bytes" },
        "numa_node": { "$ref": "#/$defs/u64", "description": "NUMA node of the GPU" },
        "page_sizes": { "$ref": "#/$defs/list", "description": "page sizes in bytes" }
      }
    },
    "group_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vbios", "gsp_firmware"],
      "properties": {
        "vbios": { "$ref": "#/$defs/version", "description": "VBIOS version" },
        "gsp_firmware": { "$ref": "#/$defs/version", "description": "GSP firmware version" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "identity", "gpu", "memory", "versions", "capabilities", "decorators"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "identity": { "$ref": "#/$defs/group_identity" },
        "gpu": { "$ref": "#/$defs/group_gpu" },
        "memory": { "$ref": "#/$defs/group_memory" },
        "versions": { "$ref": "#/$defs/group_versions" },
        "capabilities": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            { "$ref": "#/$defs/capability", "properties": { "index": { "const": 0 }, "name": { "const": "dmabuf_export" } } },
            { "$ref": "#/$defs/capability", "properties": { "index": { "const": 1 }, "name": { "const": "ats" } } },
            { "$ref": "#/$defs/capability", "properties": { "index": { "const": 2 }, "name": { "const": "self_hosted" } } },
            { "$ref": "#/$defs/capability", "properties": { "index": { "const": 3 }, "name": { "const": "display_enabled" } } },
            { "$ref": "#/$defs/capability", "properties": { "index": { "const": 4 }, "name": { "const": "soc" } } },
            { "$ref": "#/$defs/capability", "properties": { "index": { "const": 5 }, "name": { "const": "coherent_gpu_memory" } } },
            { "$ref": "#/$defs/capability", "properties": { "index": { "const": 6 }, "name": { "const": "os_device_wc_active" } } }
          ]
        },
        "decorators": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string" }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_minor", "kind", "backend", "built_for_rm_version", "running_rm_version", "versions", "devices"],
      "properties": {
        "schema": { "const": "nvrm-info/1" },
        "schema_minor": { "const": 2 },
        "kind": { "const": "document" },
        "backend": { "type": "string" },
        "built_for_rm_version": { "type": "string" },
        "running_rm_version": { "$ref": "#/$defs/text" },
        "versions": { "$ref": "#/$defs/versions" },
        "devices": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/device" }
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_minor", "kind", "backend", "built_for_rm_version", "running_rm_version", "versions"],
      "properties": {
        "schema": { "const": "nvrm-info/1" },
        "schema_minor": { "const": 2 },
        "kind": { "const": "header" },
        "backend": { "type": "string" },
        "built_for_rm_version": { "type": "string" },
        "running_rm_version": { "$ref": "#/$defs/text" },
        "versions": { "$ref": "#/$defs/versions" }
      }
    },
    "device_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_minor", "kind", "device"],
      "properties": {
        "schema": { "const": "nvrm-info/1" },
        "schema_minor": { "const": 2 },
        "kind": { "const": "device" },
        "device": { "$ref": "#/$defs/device" }
      }
    },
    "end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_minor", "kind", "count"],
      "properties": {
        "schema": { "const": "nvrm-info/1" },
        "schema_minor": { "const": 2 },
        "kind": { "const": "end" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_minor", "kind", "error"],
      "properties": {
        "schema": { "const": "nvrm-info/1" },
        "schema_minor": { "const": 2 },
        "kind": { "const": "error" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["no_backend", "open_failed", "version_mismatch", "rm_call_failed", "out_of_memory", "invalid_argument", "no_gpu", "capsicum_limit_failed", "rm_refused", "denied", "no_spare_descriptor", "range_unavailable", "not_supported", "busy"] },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
