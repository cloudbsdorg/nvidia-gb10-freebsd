diff --git a/sys/dev/pci/pci_host_generic_quirks.h b/sys/dev/pci/pci_host_generic_quirks.h
new file mode 100644
index 000000000..96d4ee576
--- /dev/null
+++ b/sys/dev/pci/pci_host_generic_quirks.h
@@ -0,0 +1,132 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 REVYTECH, Inc.
+ */
+
+/*
+ * Quirks of the generic ECAM PCIe host driver, and the pure helpers that
+ * implement them.  Nothing here touches hardware, so the file can be
+ * included from a userland test as well as from the kernel.
+ */
+
+#ifndef __PCI_HOST_GENERIC_QUIRKS_H_
+#define	__PCI_HOST_GENERIC_QUIRKS_H_
+
+#include <sys/types.h>
+
+/* Quirks */
+#define	PCIE_ECAM_DESIGNWARE_QUIRK	(1 << 0)
+/* Child will map resources to access config registers */
+#define	PCIE_CUSTOM_CONFIG_SPACE_QUIRK	(1 << 1)
+/*
+ * Only aligned 32-bit config space reads return correct data; 8- and
+ * 16-bit reads are done as a 32-bit read and the lane is extracted.
+ * Writes of every width work and are left alone.
+ */
+#define	PCIE_ECAM_32BIT_READ_QUIRK	(1 << 2)
+
+#define	PCI_ACPI_OEM_ID_SIZE		6
+#define	PCI_ACPI_OEM_TABLE_ID_SIZE	8
+
+/*
+ * The value of a "bytes"-wide config register at offset "reg", taken from
+ * the aligned dword "dword" that contains it (already in host byte order).
+ * Only the low two bits of "reg" are used: they select the byte lane.
+ * A register that does not fit inside its dword (a word at lane 3, a
+ * dword at any lane but 0), or an unsupported width, reads as all-ones.
+ */
+static __inline uint32_t
+pcie_ecam_extract(uint32_t dword, u_int reg, int bytes)
+{
+	u_int shift;
+
+	shift = (reg & 3) * 8;
+	switch (bytes) {
+	case 1:
+		return ((dword >> shift) & 0xff);
+	case 2:
+		if ((reg & 3) == 3)
+			return (~0U);
+		return ((dword >> shift) & 0xffff);
+	case 4:
+		if ((reg & 3) != 0)
+			return (~0U);
+		return (dword);
+	default:
+		return (~0U);
+	}
+}
+
+/*
+ * memcmp() without <string.h> or libkern, so that the header stays usable
+ * from userland tests and from any kernel file that includes it.
+ */
+static __inline int
+pci_acpi_oem_field_eq(const char *a, const char *b, u_int len)
+{
+	u_int i;
+
+	for (i = 0; i < len; i++)
+		if (a[i] != b[i])
+			return (0);
+	return (1);
+}
+
+/*
+ * The quirks of the host bridges described by an ACPI MCFG table with the
+ * given header fields.  The ids are compared over their full fixed width,
+ * so the table spells them with their space padding.
+ */
+static __inline uint32_t
+pci_acpi_oem_quirks(const char *oem_id, const char *oem_table_id,
+    uint32_t oem_revision)
+{
+	static const struct {
+		char		oem_id[PCI_ACPI_OEM_ID_SIZE + 1];
+		char		oem_table_id[PCI_ACPI_OEM_TABLE_ID_SIZE + 1];
+		int		match_revision;
+		uint32_t	oem_revision;
+		uint32_t	quirks;
+	} quirks[] = {
+		{ "MRVL  ", "CN9130  ", 0, 0,
+		    PCIE_ECAM_DESIGNWARE_QUIRK },
+		{ "MRVL  ", "CN913X  ", 0, 0,
+		    PCIE_ECAM_DESIGNWARE_QUIRK },
+		{ "MVEBU ", "ARMADA7K", 0, 0,
+		    PCIE_ECAM_DESIGNWARE_QUIRK },
+		{ "MVEBU ", "ARMADA8K", 0, 0,
+		    PCIE_ECAM_DESIGNWARE_QUIRK },
+		{ "MVEBU ", "CN9130  ", 0, 0,
+		    PCIE_ECAM_DESIGNWARE_QUIRK },
+		{ "MVEBU ", "CN9131  ", 0, 0,
+		    PCIE_ECAM_DESIGNWARE_QUIRK },
+		{ "MVEBU ", "CN9132  ", 0, 0,
+		    PCIE_ECAM_DESIGNWARE_QUIRK },
+		/*
+		 * Ampere Altra: sub-32-bit config reads return wrong data
+		 * (an AMD GPU's switch reads as device 0, class 0).  Linux
+		 * (AMPERE_ECAM_MCFG) matches OEM revision 1 the same way.
+		 */
+		{ "Ampere", "Altra   ", 1, 1, PCIE_ECAM_32BIT_READ_QUIRK },
+	};
+	uint32_t found;
+	u_int i;
+
+	found = 0;
+	for (i = 0; i < sizeof(quirks) / sizeof(quirks[0]); i++) {
+		if (!pci_acpi_oem_field_eq(oem_id, quirks[i].oem_id,
+		    PCI_ACPI_OEM_ID_SIZE))
+			continue;
+		if (!pci_acpi_oem_field_eq(oem_table_id,
+		    quirks[i].oem_table_id, PCI_ACPI_OEM_TABLE_ID_SIZE))
+			continue;
+		if (quirks[i].match_revision &&
+		    quirks[i].oem_revision != oem_revision)
+			continue;
+		found |= quirks[i].quirks;
+	}
+	return (found);
+}
+
+#endif /* __PCI_HOST_GENERIC_QUIRKS_H_ */
