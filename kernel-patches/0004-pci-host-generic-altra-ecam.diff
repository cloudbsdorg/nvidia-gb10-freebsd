index dc6139cf2..1ad79e672 100644
--- a/sys/dev/pci/pci_host_generic.c
+++ b/sys/dev/pci/pci_host_generic.c
@@ -319,6 +319,15 @@ generic_pcie_read_config(device_t dev, u_int bus, u_int slot,
 
 	offset = PCIE_ADDR_OFFSET(bus - sc->bus_start, slot, func, reg);
 
+	/*
+	 * The low bits of the ECAM offset are reg's, so clearing two of them
+	 * gives the dword that holds the register.
+	 */
+	if ((sc->quirks & PCIE_ECAM_32BIT_READ_QUIRK) != 0) {
+		data = le32toh(bus_read_4(sc->res, offset & ~(uint64_t)3));
+		return (pcie_ecam_extract(data, reg, bytes));
+	}
+
 	switch (bytes) {
 	case 1:
 		data = bus_read_1(sc->res, offset);
