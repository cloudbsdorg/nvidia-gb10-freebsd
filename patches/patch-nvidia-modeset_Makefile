--- nvidia-modeset/Makefile.orig
+++ nvidia-modeset/Makefile
@@ -6,6 +6,26 @@
 NVIDIA_MODESET_KERNEL = nv-modeset-kernel.o
 
 OBJS += ${NVIDIA_MODESET_KERNEL}
+SRCS += nv_version_sysctl.c
+CFLAGS += -DNV_VERSION_SYSCTL_MODESET
+
+# The symbols nvidia-drm.ko calls in this module (see the same note in
+# ../nvidia/Makefile): exported by name on arm64.
+.if ${MACHINE_CPUARCH} == "aarch64"
+EXPORT_SYMS=	nvKmsKapiGetFunctionsTable \
+		nvKmsKapiF16ToF32 \
+		nvKmsKapiF32ToF16 \
+		nvKmsKapiF32Add \
+		nvKmsKapiF32Mul \
+		nvKmsKapiF32Div \
+		nvKmsKapiF32ToUI32RMinMag \
+		nvKmsKapiUI32ToF32
+.else
+# FreeBSD 16 bsd.kmod.mk defaults EXPORT_SYMS to NO, which writes an
+# empty export_syms and objcopy-strips every global. amd64 modules
+# export every global symbol.
+EXPORT_SYMS=	YES
+.endif
 NO_OBJ = true
 
 clean:
