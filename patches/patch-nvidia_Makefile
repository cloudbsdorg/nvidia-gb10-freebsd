+# The symbols nvidia-modeset.ko and nvidia-drm.ko take from this module
+# (nv_import_pages and nv_unimport_pages: the cross-GPU import, Track #2228).
+# bsd.kmod.mk exports nothing unless EXPORT_SYMS names it, and arm64 kernel
+# modules are shared objects whose undefined symbols resolve only against
+# exported ones.
+.if ${MACHINE_CPUARCH} == "aarch64"
+EXPORT_SYMS=	nvidia_devclass \
+		nvidia_get_rm_ops \
+		nv_kthread_q_init \
