# board-amp001.env - the one place that states the facts of the test board of
# amp001 (the 16 GiB RTX 5060 Ti), sourced by make-be.sh (its defaults) and by
# the tests.  The docs and headers name this file instead of repeating the
# numbers.
BOARD_VRAM_BYTES=17179869184
BOARD_VRAM_RESERVE_MAX_BYTES=268435456
BOARD_USABLE_VRAM_BYTES=17103323136
BOARD_SM=12.0
BOARD_RM_SM=10.4
BOARD_PCI_BUS_ID=000d:01:00.0
