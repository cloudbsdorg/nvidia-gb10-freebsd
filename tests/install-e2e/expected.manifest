# The files and links make install writes on a stock FreeBSD install
# (PREFIX=/usr/local, no other drm.ko installed): path mode owner:group, or
# path link target.  tests/install-e2e/guest.sh compares the installed
# manifest (/var/db/nvidia-gb10-freebsd/installed.manifest) with this file
# and with expected.manifest.arm64 on arm64; see expected-manifest.sh.
/boot/modules/dmabuf.ko 555 root:wheel
/boot/modules/drm.ko 555 root:wheel
