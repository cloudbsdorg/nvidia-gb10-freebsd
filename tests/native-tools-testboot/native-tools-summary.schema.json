{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudbsd.org/schema/native-tools-summary-1.schema.json",
  "title": "native-tools-summary/1",
  "description": "summary.json of one native-tools test-boot run (tests/native-tools-testboot/summarize.py, Track #2362)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "run", "verdict", "native_verdict", "counts", "planned", "native_rows", "failed_rows", "skipped_rows", "rows"],
  "properties": {
    "schema": {"const": "native-tools-summary/1"},
    "version": {"const": 1},
    "run": {"type": "string"},
    "verdict": {"enum": ["pass", "fail", "incomplete"]},
    "native_verdict": {"enum": ["pass", "fail"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0},
        "needs-linux": {"type": "integer", "minimum": 0},
        "needs-linuxkpi": {"type": "integer", "minimum": 0},
        "not-available": {"type": "integer", "minimum": 0},
        "not-run": {"type": "integer", "minimum": 0}
      }
    },
    "planned": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "native_rows": {"type": "array", "items": {"type": "string"}},
    "failed_rows": {"type": "array", "items": {"type": "string"}},
    "skipped_rows": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["pass", "fail", "error", "info", "needs-linux", "needs-linuxkpi", "not-available", "not-run"]},
          "detail": {"type": "string"}
        }
      }
    },
    "gpu_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "counts", "checks", "unreadable"],
      "properties": {
        "present": {"type": "boolean"},
        "source": {"enum": ["none", "database", "stream"]},
        "run": {"type": "integer", "minimum": 1},
        "exit": {"type": "integer"},
        "error": {"type": "string"},
        "unreadable": {"type": "integer", "minimum": 0},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pass": {"type": "integer", "minimum": 0},
            "fail": {"type": "integer", "minimum": 0},
            "not_tested": {"type": "integer", "minimum": 0},
            "not_available": {"type": "integer", "minimum": 0}
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "reason"],
            "properties": {
              "name": {"type": "string"},
              "status": {"enum": ["pass", "fail", "not_tested", "not_available"]},
              "reason": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
